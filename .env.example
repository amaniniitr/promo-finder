# Any LiteLLM provider works: set the key for it and the model strings below.
GEMINI_API_KEY=
# PROMO_MODEL=gemini/gemini-3.5-flash
# PROMO_JUDGE_MODEL=gemini/gemini-2.5-flash
# PROMO_FALLBACKS=gemini/gemini-3.5-flash,gemini/gemini-2.5-flash,gemini/gemini-3.1-flash-lite
# PROMO_RPM=8
# e.g. OpenAI: OPENAI_API_KEY=... PROMO_MODEL=openai/gpt-5-mini
# e.g. Anthropic: ANTHROPIC_API_KEY=... PROMO_MODEL=anthropic/claude-sonnet-4-5
# TypeSafe Jev (judge for screening + pairwise ranking). If unset, run_v2.py falls back to the LLM judges.
TYPESAFE_API_KEY=
# PROMO_JEV_MODEL=jev-1.14.0
# Vertex AI express-mode key (optional). When set, tagging/notes use vertex/gemini-3.5-flash and audits vertex/gemini-3.8-flash.
VERTEX_API_KEY=
